        {
          "id": "documents",
          "name": "Документы",
          "type": "folder",
          "path": "%USERPROFILE%\\Documents",
          "enabled": true
        },
        {
          "id": "word-placeholder",
          "name": "Microsoft Word — пример",
          "type": "app",
          "path": "C:\\Program Files\\Microsoft Office\\root\\Office16\\WINWORD.EXE",
          "enabled": false,
          "skipIfRunning": true,
          "processName": "WINWORD.EXE"
        },
        {
          "id": "kuzgtu",
          "name": "КузГТУ",
