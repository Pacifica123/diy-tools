QWidget {
    font-family: "Segoe UI", "Arial";
    font-size: 14px;
    background: #151923;
    color: #f2f4f8;
}

QPushButton {
    background: #293144;
    border: 1px solid #3c4963;
    border-radius: 8px;
    padding: 9px 14px;
}

QPushButton:hover {
    background: #34405a;
}

QPushButton:disabled {
    color: #7e8798;
    background: #222837;
}

QLineEdit, QSpinBox, QComboBox, QTextEdit, QTableWidget {
    background: #0f1320;
    border: 1px solid #343c52;
    border-radius: 8px;
    padding: 6px;
    selection-background-color: #526aa3;
}

QHeaderView::section {
    background: #252d3f;
    color: #f2f4f8;
    padding: 6px;
    border: 1px solid #394258;
}

#PageTitle {
    font-size: 24px;
    font-weight: 700;
    padding: 10px 0;
}

#StatsLabel {
    background: #1d2434;
    border: 1px solid #343c52;
    border-radius: 10px;
    padding: 12px;
}

#TitleCard {
    background: #20283a;
    border: 2px solid #3b4763;
    border-radius: 18px;
    padding: 18px;
    min-height: 420px;
}

#TitleCard:hover {
    border: 2px solid #7894d4;
    background: #26314a;
}

#CardSide {
    color: #aab6d3;
    font-size: 13px;
}

#CardTitle {
    font-size: 25px;
    font-weight: 800;
    margin-top: 24px;
}

#CardMeta {
    font-size: 17px;
    line-height: 1.4;
    color: #dbe4ff;
    margin-top: 16px;
}

#CardComment {
    color: #cbd3e6;
    font-style: italic;
}
