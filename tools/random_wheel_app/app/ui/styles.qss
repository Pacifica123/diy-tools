QWidget {
    font-family: "Segoe UI", "Arial";
    font-size: 14px;
    background: #151923;
    color: #f2f4f8;
}

QPushButton {
    background: #293144;
    border: 1px solid #3c4963;
    border-radius: 8px;
    padding: 9px 14px;
}

QPushButton:hover {
    background: #34405a;
}

QPushButton:disabled {
    color: #7e8798;
    background: #222837;
}

QLineEdit, QSpinBox, QComboBox, QTextEdit {
    background: #0f1320;
    border: 1px solid #343c52;
    border-radius: 8px;
    padding: 6px;
    selection-background-color: #526aa3;
}

QCheckBox {
    spacing: 8px;
}

#PageTitle {
    font-size: 24px;
    font-weight: 700;
    padding: 10px 0;
}

#StatsLabel, #ResultLabel {
    background: #1d2434;
    border: 1px solid #343c52;
    border-radius: 10px;
    padding: 12px;
}

#ResultLabel {
    font-size: 17px;
    font-weight: 700;
}
